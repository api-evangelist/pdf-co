{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDF.co Barcodes Pages API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PDF Delete Pages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/edit/delete-pages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes selected pages inside a PDF file."
        },
        {
          "info": {
            "name": "Rotate Selected Pages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/edit/rotate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rotates selected pages inside a PDF file."
        },
        {
          "info": {
            "name": "Auto-rotate Pages with AI",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/edit/rotate/auto",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uses AI to automatically fix the rotation of pages inside scanned PDF based on text analysis. To change text language change the lang parameter (eng by default)."
        }
      ]
    }
  ],
  "bundled": true
}