{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDF.co Barcodes Forms API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Forms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PDF Forms Info Reader",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/info/fields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get information about fillable form fields inside a PDF file."
        }
      ]
    }
  ],
  "bundled": true
}