            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Convert URL into PDF. This method will process any JavaScript which the webpage triggers when it loads. For example if the the webpage triggers a JavaScript popup window then that will be included in the conversion process. There is no option to disable JavaScript on the supplied HTML page."
        },
        {
          "info": {
            "name": "PDF from HTML",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/convert/from/html",
