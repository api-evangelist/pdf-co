{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDF.co Barcodes PDF Conversion API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PDF Conversion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PDF to CSV",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/pdf/convert/to/csv",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Convert PDF and scanned images into CSV representation with layout, columns, rows, and tables."
        },
        {
          "info": {
            "name": "PDF to JSON",
            "type": "http"
          },
          "http": {
            "method": "POST",
