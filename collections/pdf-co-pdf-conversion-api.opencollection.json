            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Convert PDF and scanned images into JSON representation with text, fonts, images, vectors, and formatting preserved."
        },
        {
          "info": {
            "name": "PDF to JSON with AI",
            "type": "http"
          },
          "http": {
            "method": "POST",
