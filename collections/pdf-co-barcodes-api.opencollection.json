{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDF.co Barcodes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Barcodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Barcodes Generator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/barcode/generate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate high quality barcode images. Supports QR Code, Datamatrix, Code 39, Code 128, PDF417 and many other barcode types."
        },
        {
          "info": {
            "name": "Barcodes Reader",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdf.co/v1/barcode/read/from/url",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Read barcodes from images and PDF. Can read all popular barcode types from QR Code and Code 128, EAN to Datamatrix, PDF417, GS1 and many other barcodes."
        }
      ]
    }
  ],
  "bundled": true
}